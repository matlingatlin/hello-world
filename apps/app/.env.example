# Copy to .env for local development. Never commit real keys.

# Scio API base URL (apps/api)
VITE_API_URL=http://localhost:3000

# Clerk frontend key (Clerk dashboard → API keys → Publishable key)
VITE_CLERK_PUBLISHABLE_KEY=

# Local dev only — sign in with any email, no Clerk. The api needs SCIO_DEV_AUTH=1
# to accept the tokens this produces. See docs/RUNBOOK-LOCAL.md.
# VITE_DEV_AUTH=1
