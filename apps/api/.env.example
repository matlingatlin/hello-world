# Copy to .env for local development. Never commit real secrets —
# in production these live in the Azure secrets manager (ADR-0004/0009).

# Postgres connection (local: see docker-compose.yml at the repo root)
DATABASE_URL="postgresql://scio:scio@localhost:5432/scio?schema=public"

# Server
PORT=3000
# Browser origins allowed to call this API (comma-separated). The app runs on a
# different origin, so it must be named here or every request is blocked.
CORS_ORIGINS="http://localhost:5173"

# Local dev only — accepts `Bearer dev` / `Bearer dev:<email>` INSTEAD of Clerk.
# Refused when NODE_ENV=production. See docs/RUNBOOK-LOCAL.md.
# SCIO_DEV_AUTH=1

# Auth — Clerk (ADR-0008). Get keys from the Clerk dashboard.
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
# Webhook signature verification (svix) — required in production
CLERK_WEBHOOK_SIGNING_SECRET=

# The Scio engine (ADR-0006). Runs without keys on its fake provider — gate 1
# still works end to end, it just asks the guide's questions.
ENGINE_URL="http://localhost:8000"
