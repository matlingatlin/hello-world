{
  "id": "feature-booking",
  "name": "Booking feature",
  "layer": "feature",
  "description": "Guests reserve a slot and can cancel it: a validated form, a list of upcoming bookings with a cancel action, server actions, and row-level-security-respecting data access.",
  "version": "1.0.0",
  "provenance": "scio-seed",
  "provides": {
    "entities": [
      "booking"
    ],
    "operations": [
      "create_booking",
      "cancel_booking",
      "list_booking"
    ],
    "routes": [
      "/__ENTITY__",
      "/__ENTITY__/new"
    ],
    "capabilities": [
      "create",
      "list",
      "cancel",
      "server-side validation"
    ]
  },
  "package_dependencies": [
    "pkg_foundation",
    "pkg_schema",
    "pkg_design_tokens"
  ],
  "npm_dependencies": [
    "zod",
    "@supabase/supabase-js",
    "next",
    "react"
  ],
  "token_bindings": {
    "__TOKEN_ACCENT__": "accent",
    "__TOKEN_RADIUS__": "md"
  },
  "element_ids": [
    "__ENTITY__-form",
    "__ENTITY__-form-name-label",
    "__ENTITY__-form-name",
    "__ENTITY__-form-phone-label",
    "__ENTITY__-form-phone",
    "__ENTITY__-form-when-label",
    "__ENTITY__-form-when",
    "__ENTITY__-form-size-label",
    "__ENTITY__-form-size",
    "__ENTITY__-form-submit",
    "__ENTITY__-form-message",
    "__ENTITY__-list",
    "__ENTITY__-list-empty",
    "__ENTITY__-row-*",
    "__ENTITY__-page",
    "__ENTITY__-page-heading",
    "__ENTITY__-page-new-link",
    "__ENTITY__-page-no-database",
    "__ENTITY__-new-page",
    "__ENTITY__-new-heading"
  ],
  "quality": {
    "tested": true,
    "security_reviewed": true,
    "accessibility_score": 92,
    "lighthouse_score": 95,
    "review_notes": "Validation is server-side only (the client cannot skip it); data access goes through the anon client so row-level security still decides; every element carries a data-scio-id; no secrets, no dangerous HTML."
  },
  "category": "booking",
  "hashtags": [
    "form",
    "list",
    "server-actions",
    "validation",
    "rls"
  ]
}
