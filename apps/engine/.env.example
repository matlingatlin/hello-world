# Copy to .env for local development. Never commit real secrets —
# in production these live in the Azure secrets manager (ADR-0004).

# Server
ENGINE_PORT=8000

# LLM providers. With none of these set, the engine runs the full relay against
# the deterministic FakeProvider — useful locally and required in CI.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Point OpenAI calls at Azure OpenAI instead of the public API (ADR-0004)
AZURE_OPENAI_ENDPOINT=

# Force fake providers even when keys are present (deterministic runs)
SCIO_FAKE_PROVIDERS=

# --- Run profile (until the Settings UI, B049). See docs/RUNBOOK-FIRST-RUN.md.
# The cheapest honest real run — "1 + Claude" — is these three:
#   SCIO_ONLY_PROVIDER=anthropic
#   SCIO_MODEL=claude-sonnet-5
#   SCIO_MODEL_PASSES=1
# 1 does NOT mean one call: it means one model, run twice — generate, then
# review its own work. Unset means the full relay over the ranked matrix.
SCIO_ONLY_PROVIDER=
SCIO_MODEL=
SCIO_MODEL_PASSES=

# --- Generated-app workspaces
# Where built apps live, and where their installed dependencies are cached
# (shared across projects, so only the first build pays for npm install).
SCIO_WORKSPACE_ROOT=
SCIO_DEPS_CACHE=
# Skip generating + installing and build from a prepared directory instead
# (it must already contain package.json and node_modules).
SCIO_SCAFFOLD_DIR=
# Seconds before an install is given up on (default 900).
SCIO_INSTALL_TIMEOUT_S=
